# Copy to .env and replace the placeholder values. Spring Boot and Docker Compose
# both load .env from the project directory. Environment variables take precedence.
# Use unquoted Java properties values; do not wrap values in shell-style quotes.
DB_URL=jdbc:postgresql://localhost:5432/task_management
DB_USERNAME=taskapp
DB_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
